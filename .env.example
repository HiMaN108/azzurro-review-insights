# Copy to .env (root) — never commit real values.
# Local:  postgresql://<user>@localhost:5432/azzurro_reviews
# Hosted: Neon / Supabase pooled connection string
DATABASE_URL="postgresql://postgres@localhost:5432/azzurro_reviews"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Cron for scheduled collection (Australia/Sydney time). Empty = disabled.
SCRAPE_CRON="0 6 * * *"
SCRAPE_MAX_PAGES_PER_PROPERTY=40
# Cap for `pnpm scrape --full` (first load / backfill). 400 pages = 10,000 reviews.
SCRAPE_MAX_PAGES_FULL=400
SCRAPE_DELAY_MS_MIN=2500
SCRAPE_DELAY_MS_MAX=6000
# Protects POST /collector/run. Generate a random string.
ADMIN_TOKEN=""

# Optional AI tagging (off when LLM_API_KEY is empty → keyword rules only).
# Any OpenAI-compatible endpoint works. Default: Groq free tier (console.groq.com → API keys).
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL="openai/gpt-oss-120b"
LLM_BATCH_SIZE=8
# Keep under the provider's tokens-per-minute limit (Groq free: 8K TPM, 200K tokens/day).
LLM_TOKENS_PER_MINUTE=6000
LLM_MAX_REVIEWS_PER_RUN=500
# Output cap per request. Groq counts it against tokens-per-minute, so input + cap must stay < 8K.
LLM_MAX_OUTPUT_TOKENS=4096
# Provider-specific extras as JSON. For Groq gpt-oss models, low reasoning keeps replies short
# (prevents truncated JSON and saves quota). Clear it for providers that don't support it.
LLM_EXTRA_BODY='{"reasoning_effort":"low"}'

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
