# Copy to .env (root) — never commit real values.
# Local:  postgresql://<user>@localhost:5432/azzurro_reviews
# Hosted: Neon / Supabase pooled connection string
DATABASE_URL="postgresql://postgres@localhost:5432/azzurro_reviews"

# API
API_PORT=4000
CORS_ORIGIN="http://localhost:3000"
# Cron for scheduled collection (Australia/Sydney time). Empty = disabled.
SCRAPE_CRON="0 6 * * *"
SCRAPE_MAX_PAGES_PER_PROPERTY=40
# Cap for `pnpm scrape --full` (first load / backfill). 400 pages = 10,000 reviews.
SCRAPE_MAX_PAGES_FULL=400
SCRAPE_DELAY_MS_MIN=2500
SCRAPE_DELAY_MS_MAX=6000
# Protects POST /collector/run. Generate a random string.
ADMIN_TOKEN=""

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
